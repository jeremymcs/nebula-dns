# Nebula DNS - Admin UI Environment Variables
# Copyright (c) 2026 Jeremy McSpadden <jeremy@fluxlabs.net>
#
# Vercel (nebula-dns-admin, Root Directory admin-ui):
#   API_URL=https://api.nebuladns.io
#   TENANT_UI_URL=https://app.nebuladns.io

# Runtime (production - set on Vercel or Docker)
# These are sourced at runtime from the server environment
API_URL=http://localhost:4010
TENANT_UI_URL=http://localhost:4011

# Build-time fallback (development)
# These are baked into the build during `npm run build`
# In production, the runtime vars above take precedence
NEXT_PUBLIC_API_URL=http://localhost:4010
NEXT_PUBLIC_TENANT_UI_URL=http://localhost:4011

# Build-time only (Stripe client key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
