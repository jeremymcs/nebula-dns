# Nebula DNS - Policy Service Configuration
# Copy this file to .env and update the values

# Application
PORT=8080
LOG_LEVEL=debug

# Redis - Policy Cache
REDIS_URL=redis://localhost:6379

# ClickHouse - Query Logging
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=nebula_dns
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# API - Control Plane Connection
API_URL=http://localhost:3000
API_INTERNAL_KEY=your-internal-api-key

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10000

# Cache TTL (seconds)
POLICY_CACHE_TTL=60
THREAT_FEED_CACHE_TTL=300
