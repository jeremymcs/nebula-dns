# Nebula DNS - Docker Compose Configuration
# Copy this file to .env and update the values for local development

# ===========================================
# PORT MAPPING (Non-standard ports for security)
# ===========================================
# API:        4010 (internal 3000)
# UI:         4011 (internal 3000)
# PostgreSQL: 4432 (internal 5432)
# Redis:      4379 (internal 6379)
# ClickHouse: 4123 (HTTP, internal 8123), 4900 (Native, internal 9000)
# Policy-Svc: 4080 (internal 8080)
# Unbound:    5354 (DNS, internal 53)
# DNSDist:    4853 (DoT), 4443 (DoH), 4083 (Metrics)
# Adminer:    4081
# RedisInsight: 4082

# PostgreSQL
POSTGRES_USER=nebula
POSTGRES_PASSWORD=nebula
POSTGRES_DB=nebula
POSTGRES_PORT=4432

# Redis
REDIS_PASSWORD=
REDIS_PORT=4379

# ClickHouse
CLICKHOUSE_USER=nebula
CLICKHOUSE_PASSWORD=nebula
CLICKHOUSE_HTTP_PORT=4123
CLICKHOUSE_NATIVE_PORT=4900

# API Configuration
API_PORT=4010
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# UI Configuration
UI_PORT=4011
NEXT_PUBLIC_API_URL=http://localhost:4010
NEXT_PUBLIC_APP_URL=http://localhost:4011

# Email (SMTP) - Optional for local dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Stripe - Optional for local dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
