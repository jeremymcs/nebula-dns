# Nebula DNS - Environment Variables
# Copyright (c) 2026 Jeremy McSpadden <jeremy@fluxlabs.net>
#
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env files with real secrets to version control

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=nebula-dns
APP_VERSION=1.0.0

# DATABASE (Required) — Neon via Vercel Marketplace → use name DATABASE_URL
# (Neon may expose POSTGRES_URL; this app does not read that name.)
DATABASE_URL=postgresql://postgres:postgres@localhost:4432/nebula_dns

# ============================================
# REDIS (Required) — Upstash via Vercel Marketplace → use name REDIS_URL
# (Upstash may expose KV_URL; this app does not read that name.)
# Upstash TLS URLs use rediss:// — supported by ioredis in the API.
REDIS_URL=redis://localhost:4379

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# ADMIN AUTHENTICATION (Required for Admin Portal)
# ============================================
# Separate JWT secret for admin authentication (do NOT reuse JWT_SECRET)
# Generate with: openssl rand -base64 64
ADMIN_JWT_SECRET=your-admin-secret-key-change-in-production

# Initial admin account (used by seed migration)
# Email must be unique - default is admin@nebula-dns.internal
INITIAL_ADMIN_EMAIL=admin@nebula-dns.internal
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
INITIAL_ADMIN_NAME=Initial Admin

# ============================================
# ENCRYPTION KEYS (Required in Production)
# ============================================
# These keys are used to encrypt sensitive data at rest.
# CRITICAL: In production, ALL encryption keys MUST be set.
# The application will fail to start in production if these are missing.
#
# Key requirements:
# - Minimum 32 bytes (256 bits) for AES-256 encryption
# - Use cryptographically secure random generation
# - Each key should be unique - do NOT reuse keys across services
# - Store securely (e.g., HashiCorp Vault, AWS Secrets Manager)
#
# Generate secure keys using one of these commands:
#   Base64 (recommended): openssl rand -base64 32
#   Hex format:           openssl rand -hex 32
#
# Example generated keys (DO NOT USE THESE - generate your own):
#   Base64: K7gNU3sdo+OL0wNhqoVWhr3g6s1xYv72ol/pe/Unols=
#   Hex:    2bb80d537b1da3e38bd30361aa855686bde0eacd7162fef6a25fe97bf527a25b

# MFA Encryption Key - encrypts TOTP secrets stored in the database
# Used by: MfaService, PartnersService
MFA_ENCRYPTION_KEY=

# SSO Encryption Key - encrypts OIDC client secrets and SAML certificates
# Used by: SsoService
SSO_ENCRYPTION_KEY=

# SIEM Encryption Key - encrypts SIEM integration credentials (API keys, tokens)
# Used by: SiemService
SIEM_ENCRYPTION_KEY=

# Alerting Encryption Key - encrypts alert configuration credentials (webhook URLs, routing keys)
# Used by: AlertingService
# Generate with: openssl rand -base64 32
ALERTING_ENCRYPTION_KEY=
# AES-256-GCM key for DNS Management platform Cloudflare token (openssl rand -base64 32)
DNS_MANAGEMENT_ENCRYPTION_KEY=

# Internal Service Key - authenticates internal service-to-service calls
# Used by: Policy Service communication
INTERNAL_SERVICE_KEY=

# ============================================
# FRONTEND
# ============================================
# Local development:
FRONTEND_URL=http://localhost:4011
ADMIN_URL=http://localhost:4012

# Production (droplet / Vercel):
# FRONTEND_URL=https://app.shield.fluxlabs.net
# ADMIN_URL=https://admin.shield.fluxlabs.net

# ============================================
# EMAIL (SendGrid)
# ============================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=SafeDNS

# ============================================
# PAYMENTS (Stripe)
# ============================================
# Get keys from: https://dashboard.stripe.com/apikeys (Live mode for production)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Test mode (verification only): sk_test_... and matching test webhook secret

# Stripe Price IDs
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# SSO / OAuth redirect URIs (register with your IdP):
#   https://api.nebuladns.io/sso/saml/callback
#   https://api.nebuladns.io/sso/oidc/callback

# ============================================
# OBSERVABILITY
# ============================================
# Sentry DSN from: https://sentry.io/settings/projects/.../keys/
SENTRY_DSN=

# ClickHouse for query logs
CLICKHOUSE_URL=http://localhost:4123

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SECURITY
# ============================================
ENABLE_CORS=true
# Comma-separated list of allowed origins
# Local development: UI (4011), Admin UI (4012), API (4010)
# Production:
# CORS_ORIGINS=https://app.shield.fluxlabs.net,https://shield.fluxlabs.net,https://admin.shield.fluxlabs.net
CORS_ORIGINS=http://localhost:3000,http://localhost:4010,http://localhost:4011,http://localhost:4012

# Express trust proxy: CIDRs of reverse proxies allowed to set X-Forwarded-For (Caddy on droplet).
# Default when unset: 127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8. Set to "false" to disable.
# TRUSTED_PROXY_CIDRS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Shared with ui + admin-ui Vercel projects — signs X-Flux-Client-IP on /backend proxy requests.
# Generate: openssl rand -hex 32
# FLUX_CLIENT_IP_SECRET=

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_MFA_ENABLED=true
FEATURE_SSO_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true

# ============================================
# ADMIN RBAC ENFORCEMENT
# ============================================
# Enable RBAC enforcement for admin endpoints
# Set to 'true' ONLY after running migration script and reviewing shadow logs
ADMIN_RBAC_ENABLED=false

# Shadow mode: log would-be denials without actually denying
# Keep 'true' during initial rollout to collect baseline data
ADMIN_RBAC_SHADOW_MODE=true

# ============================================
# FLUX SHIELD CA (HTTPS block pages)
# ============================================
# Generate offline root with scripts/shield-ca/generate-offline-root.sh (never commit output).
# SHIELD_ROOT_CERT_PEM= (full PEM from offline root .crt — set in secret store only)
# SHIELD_ROOT_KEY_PEM= (root private PEM — secret store only; prefer offline signing)
SHIELD_CA_MASTER_KEY=
SHIELD_BLOCKPAGE_INTERNAL_SECRET=

# Block page logo uploads (local dev; droplet uses /app/uploads/block-pages volume)
BLOCK_PAGE_UPLOAD_DIR=uploads/block-pages

# MOBILE APP (Flux Shield Phase 0)
# ============================================
# Admin access token TTL (aligns with tenant JWT expiry)
ADMIN_JWT_EXPIRY=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=30
# Expo push (optional — notifications queue skips send when unset)
EXPO_ACCESS_TOKEN=
# Kill-switch for mobile impersonation (requires X-Device-Id + reason)
MOBILE_IMPERSONATION_ENABLED=false
