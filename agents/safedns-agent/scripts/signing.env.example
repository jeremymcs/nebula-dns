# Copy to signing.env and fill in ONE signing method (do not commit secrets).

# Option A: PFX file (Azure-exported code signing cert)
# FLUXSHIELD_SIGN_PFX_PATH=C:\certs\fluxshield.pfx
# FLUXSHIELD_SIGN_PFX_PASSWORD=
# Or base64 for CI:
# FLUXSHIELD_SIGN_PFX_BASE64=

# Option B: PFX stored in Azure Key Vault (secret value = base64 PFX)
# AZURE_SIGNING_KEY_VAULT=
# AZURE_SIGNING_PFX_SECRET=

# Option C: Azure Trusted Signing
# AZURE_TRUSTED_SIGNING_ACCOUNT=
# AZURE_TRUSTED_SIGNING_PROFILE=
# AZURE_TRUSTED_SIGNING_ENDPOINT=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
