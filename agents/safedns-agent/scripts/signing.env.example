# Local Windows signing only — do not commit this file with real values.
# Copy to signing.env.local and:  Get-Content signing.env.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item -Path "Env:$($matches[1].Trim())" -Value $matches[2].Trim() } }

# Recommended: Azure Key Vault export → PFX on disk
FLUXSHIELD_SIGN_PFX_PATH=C:\certs\fluxshield-codesign.pfx
FLUXSHIELD_SIGN_PFX_PASSWORD=

# Or cert imported into LocalMachine\My (Code Signing EKU)
# FLUXSHIELD_SIGN_CERT_THUMBPRINT=

# Optional: Azure Trusted Signing from this PC (az login + app registration)
# AZURE_TRUSTED_SIGNING_ACCOUNT=
# AZURE_TRUSTED_SIGNING_PROFILE=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
