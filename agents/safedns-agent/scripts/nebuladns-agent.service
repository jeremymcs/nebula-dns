[Unit]
Description=Nebula DNS Agent
Documentation=https://docs.nebuladns.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nebuladns-agent run
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nebuladns-agent

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/nebuladns /etc/resolv.conf /etc/systemd/resolved.conf.d
PrivateTmp=true

[Install]
WantedBy=multi-user.target

