# Nebula DNS - Production Secrets Example
# Copy this file to secrets.yaml and fill in the values
# DO NOT commit secrets.yaml to version control!
#
# For production, use a secrets management solution like:
# - AWS Secrets Manager with External Secrets Operator
# - HashiCorp Vault
# - Sealed Secrets
# - SOPS

apiVersion: v1
kind: Secret
metadata:
  name: api-secrets
  namespace: nebula-dns
type: Opaque
stringData:
  database-url: "postgresql://user:password@postgres:5432/nebula_dns"
  redis-url: "redis://redis:6379"
  jwt-secret: "your-super-secret-jwt-key-at-least-64-chars-long-for-security"
  sendgrid-api-key: "SG.xxxx"
  stripe-secret-key: "sk_live_xxxx"
  stripe-webhook-secret: "whsec_xxxx"
  sentry-dsn: "https://xxxx@sentry.io/xxxx"

---
apiVersion: v1
kind: Secret
metadata:
  name: policy-svc-secrets
  namespace: nebula-dns
type: Opaque
stringData:
  redis-url: "redis://redis:6379"
  clickhouse-url: "http://clickhouse:8123"

---
apiVersion: v1
kind: Secret
metadata:
  name: dnsdist-secrets
  namespace: nebula-dns
type: Opaque
stringData:
  api-key: "your-dnsdist-api-key"

---
apiVersion: v1
kind: Secret
metadata:
  name: dnsdist-tls
  namespace: nebula-dns
type: kubernetes.io/tls
data:
  # Base64 encoded TLS certificate and key
  tls.crt: LS0tLS1CRUdJTi... # Your TLS certificate
  tls.key: LS0tLS1CRUdJTi... # Your TLS private key
