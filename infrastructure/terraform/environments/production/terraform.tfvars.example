# DigitalOcean Configuration
# Get your API token from: https://cloud.digitalocean.com/account/api/tokens
do_token = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Region Configuration
# Available regions: nyc1, nyc3, sfo3, ams3, sgp1, lon1, fra1, tor1, blr1, syd1
region = "nyc3"

# Environment
environment = "production"

# ClickHouse Cloud Configuration
# Get credentials from: https://clickhouse.cloud/
# Settings -> API Keys -> Create Key (with admin permissions)
# Organization ID from: Settings -> Organization -> ID
clickhouse_org_id       = "org_xxxxxxxxxxxxxxxxxxxxxxxx"
clickhouse_token_key    = "key_xxxxxxxxxxxxxxxxxxxxxxxx"
clickhouse_token_secret = "secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
