# Nebula DNS - UI Configuration
# Copy this file to .env.local and update the values
#
# Vercel (nebula-dns-app, Root Directory ui):
#   API_URL=https://api.nebuladns.io
#   APP_URL=https://app.nebuladns.io
#   ADMIN_UI_URL=https://admin.nebuladns.io

# Runtime (production - set on Vercel or Docker)
# These are sourced at runtime from the server environment
API_URL=http://localhost:4010
APP_URL=http://localhost:4011
ADMIN_UI_URL=http://localhost:4012

# Must match api + admin-ui FLUX_CLIENT_IP_SECRET (openssl rand -hex 32)
# FLUX_CLIENT_IP_SECRET=

# Build-time fallback (development)
# These are baked into the build during `npm run build`
# In production, the runtime vars above take precedence
NEXT_PUBLIC_API_URL=http://localhost:4010
NEXT_PUBLIC_APP_URL=http://localhost:4011
NEXT_PUBLIC_ADMIN_UI_URL=http://localhost:4012

# Feature Flags
NEXT_PUBLIC_ENABLE_SSO=true
NEXT_PUBLIC_ENABLE_MFA=true
NEXT_PUBLIC_ENABLE_API_KEYS=true

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Stripe (Client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
