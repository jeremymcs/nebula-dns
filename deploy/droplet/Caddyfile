{
  email {$ACME_EMAIL}
}

api.nebuladns.io, api.shield.fluxlabs.net {
  encode gzip
  reverse_proxy api:3000
}

# HTTP sinkhole for block-page DNS answers (see docs/modules/block-pages/DROPLET-DEPLOY.md)
:80 {
  rewrite * /block-pages/public/serve
  reverse_proxy api:3000 {
    header_up X-Forwarded-Host {http.request.host}
    header_up X-Real-IP {http.request.remote.host}
  }
}

dns1.nebuladns.io, dns2.nebuladns.io, dns1.shield.fluxlabs.net, dns2.shield.fluxlabs.net {
  # Caddy issues one ACME certificate per hostname (not a single multi-SAN cert).
  # sync-caddy-certs.sh copies the primary cert to server.crt/key and additional hostnames
  # to sni-*.crt/key so dnsdist DoT on :853 can present the correct cert per SNI.
  # Public DoH on :443 (TLS terminated here). Backend DoH listens on dnsdist:8443.
  reverse_proxy https://dnsdist:8443 {
    header_up Host {host}
    transport http {
      tls
      tls_insecure_skip_verify
    }
  }
}
