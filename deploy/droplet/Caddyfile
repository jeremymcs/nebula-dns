{
  email {$ACME_EMAIL}
}

api.nebuladns.io {
  encode gzip
  reverse_proxy api:3000
}

# HTTP sinkhole for block-page DNS answers (see docs/modules/block-pages/DROPLET-DEPLOY.md)
:80 {
  rewrite * /block-pages/public/serve
  reverse_proxy api:3000 {
    header_up X-Forwarded-Host {http.request.host}
    header_up X-Real-IP {http.request.remote.host}
  }
}

dns1.nebuladns.io, dns2.nebuladns.io {
  # Single ACME certificate with SANs for both names (used by Caddy DoH and synced to dnsdist DoT).
  # Public DoH on :443 (TLS terminated here). Backend DoH listens on dnsdist:8443.
  reverse_proxy https://dnsdist:8443 {
    header_up Host {host}
    transport http {
      tls
      tls_insecure_skip_verify
    }
  }
}
