# Nebula DNS — droplet production environment
# Copy to .env on the server and fill in values from Neon, Upstash, ClickHouse Cloud, Stripe, etc.
# Never commit .env.

# ============================================
# DEPLOY / CI
# ============================================
IMAGE_TAG=latest
ACME_EMAIL=ops@yourdomain.com

# ============================================
# API (NestJS) — required
# ============================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Neon Postgres (Vercel Marketplace) — use sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nebula_dns?sslmode=require

# Upstash Redis (Vercel Marketplace) — use rediss:// for TLS
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Auth & encryption (generate on droplet: openssl rand -base64 64 / -base64 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=
MFA_ENCRYPTION_KEY=
SSO_ENCRYPTION_KEY=
SIEM_ENCRYPTION_KEY=
ALERTING_ENCRYPTION_KEY=
INTERNAL_SERVICE_KEY=

# App URLs (Vercel frontends)
FRONTEND_URL=https://app.nebuladns.io
ADMIN_URL=https://admin.nebuladns.io
CORS_ORIGINS=https://app.nebuladns.io,https://admin.nebuladns.io

# ClickHouse Cloud (primary analytics store)
CLICKHOUSE_URL=https://YOUR-CLUSTER.clickhouse.cloud:8443
CLICKHOUSE_DATABASE=nebula_dns
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Optional local ClickHouse fallback: docker compose --profile clickhouse-local up -d
# CLICKHOUSE_URL=http://clickhouse:8123

# Email / billing / observability
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@nebuladns.io
EMAIL_FROM_NAME=Nebula DNS
STRIPE_SECRET_KEY=sk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
SENTRY_DSN=

# Stripe Dashboard → Webhooks → endpoint URL:
#   https://api.nebuladns.io/payments/webhook

# SSO / OAuth (register these redirect URIs with your IdP)
#   SAML ACS:  https://api.nebuladns.io/sso/saml/callback
#   OIDC:      https://api.nebuladns.io/sso/oidc/callback

# ============================================
# POLICY-SVC (Go)
# ============================================
FAIL_MODE=open
LOG_LEVEL=info
REDIS_URL=rediss://default:PASSWORD@HOST:6379
CLICKHOUSE_URL=https://YOUR-CLUSTER.clickhouse.cloud:8443
CLICKHOUSE_DATABASE=nebula_dns
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
API_URL=https://api.nebuladns.io
API_INTERNAL_KEY=

# ============================================
# DNSDIST
# ============================================
POLICY_SVC_URL=http://policy-svc:8080
DNSDIST_API_KEY=

# TLS for DoT (:853) and internal DoH (:8443) — see certs/README.md and scripts/
# Public DoH uses Caddy on :443 for dns1/dns2 hostnames.
