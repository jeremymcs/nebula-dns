# Flux Shield — droplet production environment
# Copy to .env on the server. Never commit .env.
#
# ── Vercel Marketplace → Flux Shield env names ─────────────────────────────────────
# The API and policy-svc read the names in the right column only.
#
# | Source (Neon / Upstash)     | Common Vercel env names | Set on droplet as   |
# |-----------------------------|-------------------------|---------------------|
# | Neon Postgres               | POSTGRES_URL, DATABASE_URL | DATABASE_URL     |
# | Upstash Redis               | REDIS_URL, KV_URL          | REDIS_URL        |
#
# Copy Neon’s pooled connection string into DATABASE_URL (include ?sslmode=require).
# Copy Upstash’s TLS URL (rediss://…) into REDIS_URL for both api and policy-svc.
# POSTGRES_URL and KV_URL are not read by this codebase — rename when copying.

# ============================================
# DEPLOY / CI
# ============================================
IMAGE_TAG=latest
ACME_EMAIL=ops@yourdomain.com

# ============================================
# API (NestJS) — required
# ============================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Neon (Vercel Marketplace) — sslmode=require; add USER and PASSWORD from the Neon dashboard
DATABASE_URL=postgresql://USER@HOST/nebula_dns?sslmode=require

# Upstash (Vercel Marketplace) — TLS; ioredis (API) and go-redis (policy-svc) support rediss://
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Optional compile-on-miss (set the same INTERNAL_API_SECRET on api + policy-svc)
# INTERNAL_API_SECRET=
# POLICY_COMPILE_API_URL=http://api:3000
# CATEGORY_FEEDS_ENABLED=mixed_adult,gambling,dating,social_networks,games,audio-video,ddos,dialer,drogue,agressif
# Full UT1 adult (~4.6M domains, ~202MB Redis / 16 shards) — add adult explicitly, e.g.:
# CATEGORY_FEEDS_ENABLED=mixed_adult,gambling,adult
# CATEGORY_SHARD_COUNT=16

# Auth & encryption (generate on droplet: openssl rand -base64 64 / -base64 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=
MFA_ENCRYPTION_KEY=
SSO_ENCRYPTION_KEY=
SIEM_ENCRYPTION_KEY=
ALERTING_ENCRYPTION_KEY=
INTERNAL_SERVICE_KEY=

# App URLs (Vercel frontends)
FRONTEND_URL=https://app.shield.fluxlabs.net
ADMIN_URL=https://admin.shield.fluxlabs.net
CORS_ORIGINS=https://app.shield.fluxlabs.net,https://shield.fluxlabs.net,https://admin.shield.fluxlabs.net

# Client IP trust (Caddy → API). Default private/Docker CIDRs apply when TRUSTED_PROXY_CIDRS is unset.
# TRUSTED_PROXY_CIDRS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8
# Same value on Vercel ui + admin-ui — signs browser IP on /backend/* (openssl rand -hex 32)
# FLUX_CLIENT_IP_SECRET=

# ClickHouse (self-hosted on this droplet — compose service `clickhouse`, internal only)
# Defaults in docker-compose.yml point API/policy-svc at http://clickhouse:8123
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=nebula_dns
CLICKHOUSE_USER=nebula
# CLICKHOUSE_PASSWORD — required (openssl rand -base64 24); must match compose clickhouse service

# Email / observability
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@shield.fluxlabs.net
EMAIL_FROM_NAME=Flux Shield
SENTRY_DSN=

# Stripe — LIVE mode for launch (Dashboard → Live mode)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# Stripe live webhook endpoint:
#   https://api.shield.fluxlabs.net/payments/webhook
#
# Verification only (test mode): temporarily use sk_test_… + test whsec_… and Stripe
# “Send test webhook” — switch back to live keys before accepting real payments.

# SSO / OAuth (register these redirect URIs with your IdP)
#   SAML ACS:  https://api.shield.fluxlabs.net/sso/saml/callback
#   OIDC:      https://api.shield.fluxlabs.net/sso/oidc/callback

# ============================================
# POLICY-SVC (Go)
# ============================================
FAIL_MODE=open
LOG_LEVEL=info
REDIS_URL=rediss://default:PASSWORD@HOST:6379
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=nebula_dns
CLICKHOUSE_USER=nebula
# CLICKHOUSE_PASSWORD — required (openssl rand -base64 24); must match compose clickhouse service
API_URL=https://api.shield.fluxlabs.net
API_INTERNAL_KEY=

# System health probes (Docker network — API container → unbound/dnsdist)
UNBOUND_HOST=unbound
UNBOUND_PORT=53
DNSDIST_URL=http://dnsdist:8083

# ============================================
# DNSDIST
# ============================================
POLICY_SVC_URL=http://policy-svc:8080
# Shared with dnsdist container and API admin health checks (X-API-Key)
DNSDIST_API_KEY=

# TLS for DoT (:853) and internal DoH (:8443) — see certs/README.md and scripts/
# Public DoH uses Caddy on :443 for dns1/dns2 hostnames.

# IPv4 returned for blockpage DNS responses (droplet public IP)
BLOCKPAGE_IP=

# ============================================
# FLUX SHIELD CA (HTTPS block pages)
# ============================================
# Offline root PEM (see docs/modules/block-pages/SHIELD-CA-ROOT-RUNBOOK.md)
# SHIELD_ROOT_CERT_PEM=
# SHIELD_ROOT_KEY_PEM=
# Encrypts intermediate CA keys in Postgres (openssl rand -base64 32)
SHIELD_CA_MASTER_KEY=
# Shared with shield-blockpage / internal TLS ask (openssl rand -hex 32)
SHIELD_BLOCKPAGE_INTERNAL_SECRET=
# Writable path for tenant block-page logos (match docker-compose volume mount)
BLOCK_PAGE_UPLOAD_DIR=/app/uploads/block-pages
